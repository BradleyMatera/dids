---
layout: null
permalink: /search.json
---
[
{% assign searchable_pages = site.pages | where_exp: "item", "item.title != nil" %}
{% for item in searchable_pages %}
  {
    "title": {{ item.title | jsonify }},
    "url": {{ item.url | jsonify }},
    "description": {{ item.description | default: "" | strip_html | normalize_whitespace | jsonify }},
    "content": {{ item.content | markdownify | strip_html | normalize_whitespace | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
